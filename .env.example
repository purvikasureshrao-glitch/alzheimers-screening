# Copy this file to a new file named ".env" (exactly that name, no .txt) and fill in YOUR OWN values.
# Optional: without a .env the app still works and saves records to data/local_store.json.
# Get both values in Supabase: Project Settings > API. Use the service_role key (secret), NOT the anon key.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=paste-your-service-role-key-here
